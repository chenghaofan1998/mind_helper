{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.commandpocket.note",
  "version": "0.2.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/web-dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "window.*",
    "clipboard.*",
    "events.*",
    "storage.*",
    "os.*"
  ],
  "modes": {
    "window": {
      "title": "Action Pocket",
      "icon": "/icons/action-pocket.png",
      "width": 560,
      "height": 680,
      "minWidth": 440,
      "minHeight": 560,
      "center": true,
      "alwaysOnTop": false,
      "fullScreen": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "enableInspector": false,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "CommandPocket",
    "resourcesPath": "/web-dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/src/neutralino.js",
    "binaryVersion": "5.6.0"
  }
}
