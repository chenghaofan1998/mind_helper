{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".server-dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["server/**/*.ts", "src/knowledge/types.ts"],
  "exclude": ["server/**/*.test.ts"]
}
