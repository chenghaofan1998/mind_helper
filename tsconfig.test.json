{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["server/**/*.ts", "src/**/*.test.ts", "src/knowledge/types.ts", "src/preferenceStore.ts", "src/search.ts"]
}
